# Copy to .env.local and fill in real values (never commit .env.local)

HOST=0.0.0.0
PORT=8100
LOG_LEVEL=INFO

# ── Supabase (required) ────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Auth secrets (generate with: openssl rand -hex 32) ─────────────
JWT_SECRET=change-me-32-char-random
SECRET_KEY=change-me-32-char-random
# Optional: 32-byte hex AES key for encrypting stored user keys
# AES_KEY=

# ── CORS ───────────────────────────────────────────────────────────
CORS_ORIGINS=https://r2p-frontend.vercel.app

# ── AI / RAG (optional until used) ─────────────────────────────────
GEMINI_API_KEY=
NVIDIA_API_KEY=
NVIDIA_NIM_API_KEY=
PINECONE_API_KEY=
PINECONE_HOST=
PINECONE_INDEX=
LLMWHISPERER_API_KEY=

# ── Admin emails allowed to create schools (comma-separated) ───────
# ADMIN_EMAILS=kabilan3120@gmail.com
