# ── R2P MCP Backend — local dev environment ──────────────────────────────────
# Copy this to .env.local and fill in real values.
# Never commit .env.local to git.

# Server
HOST=0.0.0.0
PORT=8100
LOG_LEVEL=INFO

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT (set a random 32+ char secret for local)
JWT_SECRET=change-me-to-a-random-32-char-string
SECRET_KEY=change-me-to-a-random-32-char-string

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# AI / Vector providers
NVIDIA_API_KEY=
NVIDIA_NIM_API_KEY=
PINECONE_API_KEY=
PINECONE_HOST=https://your-index.svc.async-prod.aws.pinecone.io
PINECONE_INDEX=textbook-rag
LLMWHISPERER_API_KEY=
GEMINI_API_KEY=
FIREBASE_CREDENTIALS_PATH=
